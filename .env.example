# VayuMitra Server Configuration

# Optional: Google Gemini API key for GenAI-powered reasoning & Q&A copilot
# If not provided, VayuMitra operates using its verified rule-based environmental science engine.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Preferred model (defaults to gemini-1.5-flash or gemini-2.0-flash)
GEMINI_MODEL=gemini-1.5-flash

# Cache TTL in milliseconds (default: 900000 = 15 minutes)
CACHE_TTL_MS=900000

# Server Port (default 3000)
PORT=3000
